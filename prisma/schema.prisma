// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  GRANTOR
  COORDINATOR
  SCHOLAR
  APPLICANT
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum GradeReportStatus {
  PENDING
  APPROVED
  FLAGGED
  REJECTED
}

enum ContractStatus {
  PENDING
  SIGNED
  TERMINATED
}

enum DisbursementStatus {
  PENDING
  RELEASED
  CLAIMED
  CANCELLED
}

enum DocumentStatus {
  PENDING
  PASSED_PRECHECK
  NEEDS_REUPLOAD
  STUDENT_CONFIRMED
  VERIFIED
  REJECTED
}

// ==========================================
// CORE USER & PROFILE MODELS
// ==========================================

model User {
  user_id       Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(255)
  password_hash String    @db.VarChar(255)
  role          Role      @default(APPLICANT)
  is_active     Boolean   @default(true)
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  employee         Employee?
  scholar_profile  ScholarProfile?
  signed_contracts          Contract[]      @relation("UserSignedContracts")
  messages_sent             Message[]       @relation("UserSentMessages")
  scholar_conversations     Conversation[]  @relation("ScholarConversations")
  coordinator_conversations Conversation[]  @relation("CoordinatorConversations")
  forum_posts               ForumPost[]     @relation("UserForumPosts")
  forum_comments            ForumComment[]  @relation("UserForumComments")
  auditLogs                 AuditLog[]

  submitted_schools         SchoolGradingSystem[] @relation("SchoolGradingSubmittedBy")
  systemSettings SystemSetting[] @relation("SettingsUpdatedBy")

  @@map("users")
}

model Employee {
  employee_id Int     @id @default(autoincrement())
  user_id     Int     @unique
  first_name  String  @db.VarChar(100)
  last_name   String  @db.VarChar(100)
  title       String? @db.VarChar(150)
  department  String? @db.VarChar(150)
  bio         String? @db.Text
  avatar_url  String? @db.VarChar(255)
  banner_url  String? @db.VarChar(255)
  is_active   Boolean @default(true)

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  reviewed_applications  Application[]        @relation("EmployeeReviewedApplications")
  reviewed_grade_reports GradeReport[]        @relation("EmployeeReviewedGradeReports")
  approved_disbursements Disbursement[]       @relation("EmployeeApprovedDisbursements")
  reviewed_documents     ScholarDocument[]    @relation("EmployeeReviewedDocuments")
  verified_schools       SchoolGradingSystem[] @relation("SchoolGradingVerifiedBy")
  frozen_prospectuses    ScholarProspectus[]  @relation("EmployeeFrozenProspectus")
  meetings               Meeting[]

  @@map("employees")
}

model ScholarProfile {
  profile_id               Int     @id @default(autoincrement())
  user_id                  Int     @unique
  first_name               String  @default("")  @db.VarChar(100)
  last_name                String  @default("")  @db.VarChar(100)
  phone_number             String  @unique @db.VarChar(30)
  student_address          String? @db.Text
  school_address           String? @db.Text
  student_number           String? @unique @db.VarChar(50)
  relative_employee        String? @db.VarChar(150)
  scholarship_track        String? @db.VarChar(100)
  course_of_study          String? @db.VarChar(150)
  school_name              String? @db.VarChar(150)
  school_id                Int?
  academic_baseline_status String  @default("PENDING_SCHOOL_SELECTION") @db.VarChar(50)
  current_year_level       Int?    @db.SmallInt
  bio                      String? @db.Text
  avatar_url               String? @db.VarChar(255)
  banner_url               String? @db.VarChar(255)

  user                  User                 @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  school_grading_system SchoolGradingSystem? @relation(fields: [school_id], references: [school_id], onDelete: SetNull)

  applications  Application[]
  grade_reports GradeReport[]
  contracts     Contract[]
  disbursements Disbursement[]
  documents     ScholarDocument[]
  meetings      Meeting[]
  prospectus    ScholarProspectus?

  @@map("scholar_profiles")
}

// ==========================================
// SCHOLARSHIP WORKFLOW MODELS
// ==========================================

model Application {
  application_id          Int               @id @default(autoincrement())
  scholar_profile_id      Int
  reviewed_by_employee_id Int?
  status                  ApplicationStatus @default(PENDING)
  stage                   String            @db.VarChar(100)
  submitted_at                DateTime          @default(now())
  stage_updated_at            DateTime?
  interview_at                DateTime?
  interview_meeting_link      String?           @db.VarChar(255)
  interview_calendar_event_id String?           @db.VarChar(255)
  reschedule_reason           String?           @db.Text
  decision_at                 DateTime?
  verified_at                 DateTime?
  provider_notes              String?           @db.Text
  rejection_reason            String?           @db.Text
  closed_at                   DateTime?

  scholar_profile      ScholarProfile @relation(fields: [scholar_profile_id], references: [profile_id], onDelete: Cascade)
  reviewed_by_employee Employee?       @relation("EmployeeReviewedApplications", fields: [reviewed_by_employee_id], references: [employee_id])
  meeting              Meeting?

  @@map("applications")
}

model GradeReport {
  report_id               Int               @id @default(autoincrement())
  scholar_profile_id      Int
  document_id             Int?
  academic_year           String            @db.VarChar(15)
  semester                String            @db.VarChar(15)
  term                    String?           @db.VarChar(15)
  gpa                     Decimal           @db.Decimal(5, 2)
  status                  GradeReportStatus @default(PENDING)
  evaluation_flag         String?           @db.VarChar(50)  // "CLEARED", "BELOW_PASSING_MARK", "ACADEMIC_FAILURE"
  is_eligible             Boolean           @default(false)
  submitted_at            DateTime          @default(now())
  reviewed_at             DateTime?
  reviewed_by_employee_id Int?
  remarks                 String?           @db.Text

  scholar_profile      ScholarProfile @relation(fields: [scholar_profile_id], references: [profile_id], onDelete: Cascade)
  reviewed_by_employee Employee?       @relation("EmployeeReviewedGradeReports", fields: [reviewed_by_employee_id], references: [employee_id])
  document             ScholarDocument? @relation(fields: [document_id], references: [document_id], onDelete: SetNull)
  grade_items          GradeItem[]

  @@map("grade_reports")
}

model Contract {
  contract_id         Int            @id @default(autoincrement())
  scholar_profile_id  Int
  signed_by_user_id   Int?
  contract_number     String         @db.VarChar(100)
  document_url        String?        @db.VarChar(255)
  signed_document_url String?        @db.VarChar(255)
  signature_url       String?        @db.VarChar(255)
  certificate_id      String?        @unique @db.VarChar(100)
  document_hash       String?        @db.VarChar(128)
  signer_ip           String?        @db.VarChar(100)
  signer_user_agent   String?        @db.Text
  status              ContractStatus @default(PENDING)
  effective_date      DateTime?      @db.Date
  expiry_date         DateTime?      @db.Date
  signed_at           DateTime?
  version             Int            @default(1)

  scholar_profile ScholarProfile @relation(fields: [scholar_profile_id], references: [profile_id], onDelete: Cascade)
  signed_by_user  User?          @relation("UserSignedContracts", fields: [signed_by_user_id], references: [user_id])

  @@map("contracts")
}

model Disbursement {
  disbursement_id         Int                @id @default(autoincrement())
  scholar_profile_id      Int
  academic_year           String             @db.VarChar(15)
  semester                String             @db.VarChar(15)
  amount                  Decimal            @db.Decimal(10, 2)
  check_payee             String?            @db.VarChar(100)
  check_number            String?            @db.VarChar(100)
  payment_method          String?            @db.VarChar(100)
  status                  DisbursementStatus @default(PENDING)
  date_issued             DateTime?          @db.Date
  date_claimed            DateTime?          @db.Date
  approved_by_employee_id Int?
  remarks                 String?            @db.Text

  scholar_profile      ScholarProfile @relation(fields: [scholar_profile_id], references: [profile_id], onDelete: Cascade)
  approved_by_employee Employee?       @relation("EmployeeApprovedDisbursements", fields: [approved_by_employee_id], references: [employee_id])

  @@map("disbursements")
}

model ScholarDocument {
  document_id             Int            @id @default(autoincrement())
  scholar_profile_id      Int
  document_type           String         @db.VarChar(100)
  label                   String?        @db.VarChar(100)
  file_name               String?        @db.VarChar(100)
  file_url                String         @db.VarChar(255)
  file_size               String?        @db.VarChar(100)
  file_type               String         @db.VarChar(20)
  status                  DocumentStatus @default(PENDING)
  rejection_reason        String?        @db.Text
  extracted_data          Json?          @db.JsonB // Raw JSON returned by Parseur AI
  confirmed_data          Json?          @db.JsonB // Student-reviewed/corrected data
  parseur_doc_id          String?        @db.VarChar(100)
  uploaded_at             DateTime       @default(now())
  verified_at             DateTime?
  reviewed_by_employee_id Int?

  scholar_profile      ScholarProfile @relation(fields: [scholar_profile_id], references: [profile_id], onDelete: Cascade)
  reviewed_by_employee Employee?       @relation("EmployeeReviewedDocuments", fields: [reviewed_by_employee_id], references: [employee_id])
  grade_reports        GradeReport[]
  prospectus_documents ScholarProspectus[]
  credited_subjects    ProspectusSubject[]

  @@map("scholar_documents")
}

model GradeItem {
  item_id      Int     @id @default(autoincrement())
  report_id    Int
  subject_code String  @db.VarChar(50)  // e.g. "IT 411", "GE 101"
  subject_name String? @db.VarChar(150) // e.g. "Capstone Project 1"
  units        Decimal @db.Decimal(3, 1) // e.g. 3.0, 1.5
  grade        Decimal @db.Decimal(5, 2) // e.g. 3.50, 92.00, 1.00
  raw_status   String? @db.VarChar(50)  // e.g. "PASSED", "FAILED", "DROPPED", "7.2"

  grade_report GradeReport @relation(fields: [report_id], references: [report_id], onDelete: Cascade)

  @@map("grade_items")
}

// ==========================================
// COMMUNICATION & SCHEDULING MODELS
// ==========================================

model Conversation {
  conversation_id      Int       @id @default(autoincrement())
  scholar_user_id      Int
  coordinator_user_id  Int
  subject              String?   @db.VarChar(255)
  status               String    @default("ACTIVE") @db.VarChar(50) // "ACTIVE", "PENDING_REQUEST", "ACCEPTED", "REJECTED"
  request_note         String?   @db.Text
  last_message_at      DateTime?
  last_message_preview String?   @db.Text
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  scholar     User      @relation("ScholarConversations", fields: [scholar_user_id], references: [user_id], onDelete: Cascade)
  coordinator User      @relation("CoordinatorConversations", fields: [coordinator_user_id], references: [user_id], onDelete: Cascade)
  messages    Message[]

  @@unique([scholar_user_id, coordinator_user_id])
  @@index([scholar_user_id])
  @@index([coordinator_user_id])
  @@map("conversations")
}

model Message {
  message_id      Int       @id @default(autoincrement())
  conversation_id Int
  sender_user_id  Int
  message_text    String    @db.Text
  is_read         Boolean   @default(false)
  sent_at         DateTime  @default(now())
  read_at         DateTime?

  conversation Conversation @relation(fields: [conversation_id], references: [conversation_id], onDelete: Cascade)
  sender_user  User         @relation("UserSentMessages", fields: [sender_user_id], references: [user_id])

  @@index([conversation_id])
  @@map("messages")
}

model ForumPost {
  post_id        Int            @id @default(autoincrement())
  author_user_id Int
  title          String         @db.VarChar(255)
  content        String         @db.Text
  category       String         @default("GENERAL") @db.VarChar(50) // "ACADEMIC", "STIPENDS", "GENERAL", "ANNOUNCEMENT"
  is_pinned      Boolean        @default(false)
  views_count    Int            @default(0)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  author   User           @relation("UserForumPosts", fields: [author_user_id], references: [user_id], onDelete: Cascade)
  comments ForumComment[]

  @@index([category])
  @@index([created_at])
  @@map("forum_posts")
}

model ForumComment {
  comment_id     Int       @id @default(autoincrement())
  post_id        Int
  author_user_id Int
  content        String    @db.Text
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  post   ForumPost @relation(fields: [post_id], references: [post_id], onDelete: Cascade)
  author User      @relation("UserForumComments", fields: [author_user_id], references: [user_id], onDelete: Cascade)

  @@index([post_id])
  @@map("forum_comments")
}

model Meeting {
  meeting_id         Int       @id @default(autoincrement())
  scholar_profile_id Int?
  employee_id        Int?
  application_id     Int?      @unique
  title              String    @db.VarChar(150)
  meeting_date       DateTime  @db.Date
  meeting_time       String?   @db.VarChar(50)
  scheduled_at       DateTime?
  duration_minutes   Int?      @default(45)
  meeting_link       String?   @db.VarChar(255)
  calendar_event_id  String?   @db.VarChar(255)
  invitee_role       String?   @db.VarChar(100)
  status             String?   @db.VarChar(100)
  notes              String?   @db.Text
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  scholar_profile ScholarProfile? @relation(fields: [scholar_profile_id], references: [profile_id], onDelete: Cascade)
  employee        Employee?       @relation(fields: [employee_id], references: [employee_id])
  application     Application?    @relation(fields: [application_id], references: [application_id], onDelete: Cascade)

  @@index([scheduled_at])
  @@index([status])
  @@map("meetings")
}

model AuditLog {
  log_id     Int      @id @default(autoincrement())
  user_id    Int?
  action     String   @db.VarChar(100)
  details    String?  @db.Text
  created_at DateTime @default(now())

  user User? @relation(fields: [user_id], references: [user_id], onDelete: SetNull)

  @@map("audit_logs")
}

model SystemSetting {
  setting_id          Int      @id @default(autoincrement())
  grade_threshold     Decimal  @default(90.00) @db.Decimal(5, 2)
  updated_at          DateTime @updatedAt
  updated_by_user_id  Int?

  updated_by_user User? @relation("SettingsUpdatedBy", fields: [updated_by_user_id], references: [user_id])

  @@map("system_settings")
}

model SchoolGradingSystem {
  school_id               Int              @id @default(autoincrement())
  school_name             String           @unique @db.VarChar(150)
  grading_scale           String           @db.VarChar(50) // e.g. "PERCENTAGE_100", "NUMERIC_5_POINT", "NUMERIC_4_POINT"
  passing_grade           Decimal          @db.Decimal(5, 2) // e.g. 75.00, 3.00, 2.00
  highest_grade           Decimal          @db.Decimal(5, 2) // e.g. 100.00, 1.00, 4.00
  failing_grade           Decimal          @db.Decimal(5, 2) // e.g. 50.00, 5.00, 1.00
  min_grade               Decimal?         @db.Decimal(5, 2)
  max_grade               Decimal?         @db.Decimal(5, 2)
  is_verified             Boolean          @default(true)
  submitted_by_user_id    Int?
  verified_by_employee_id Int?
  special_codes           Json?            @db.JsonB
  notes                   String?          @db.Text
  created_at              DateTime         @default(now())
  updated_at              DateTime         @updatedAt

  submitted_by_user       User?            @relation("SchoolGradingSubmittedBy", fields: [submitted_by_user_id], references: [user_id], onDelete: SetNull)
  verified_by_employee    Employee?        @relation("SchoolGradingVerifiedBy", fields: [verified_by_employee_id], references: [employee_id], onDelete: SetNull)
  scholar_profiles        ScholarProfile[]

  @@map("school_grading_systems")
}

model ScholarProspectus {
  prospectus_id         Int                @id @default(autoincrement())
  scholar_profile_id    Int                @unique
  document_id           Int?
  curriculum_year       String             @db.VarChar(50) // e.g. "2023-2024"
  course_code           String?            @db.VarChar(50) // e.g. "BSIT"
  course_name           String             @db.VarChar(150) // e.g. "Bachelor of Science in Information Technology"
  total_units           Decimal?           @db.Decimal(5, 1)
  is_frozen             Boolean            @default(false)
  frozen_at             DateTime?
  frozen_by_employee_id Int?
  status                String             @default("DRAFT") @db.VarChar(50) // "DRAFT", "PENDING_REVIEW", "FROZEN"
  created_at            DateTime           @default(now())
  updated_at            DateTime           @updatedAt

  scholar_profile       ScholarProfile     @relation(fields: [scholar_profile_id], references: [profile_id], onDelete: Cascade)
  document              ScholarDocument?   @relation(fields: [document_id], references: [document_id], onDelete: SetNull)
  frozen_by_employee    Employee?          @relation("EmployeeFrozenProspectus", fields: [frozen_by_employee_id], references: [employee_id])
  subjects              ProspectusSubject[]

  @@map("scholar_prospectus")
}

model ProspectusSubject {
  subject_id             Int               @id @default(autoincrement())
  prospectus_id          Int
  subject_code           String            @db.VarChar(50)  // e.g. "IT 101", "CCE 102"
  descriptive_title      String            @db.VarChar(200) // e.g. "Introduction to Computing"
  units                  Decimal           @db.Decimal(3, 1) // e.g. 3.0
  year_level             Int               @db.SmallInt     // 1, 2, 3, 4
  semester               String            @db.VarChar(50)  // "1st Semester", "2nd Semester", "Summer"
  prerequisites          Json?             @db.JsonB        // e.g. ["CCE 101"]
  status                 String            @default("UNTAKEN") @db.VarChar(50) // "UNTAKEN", "CREDITED", "ENROLLED", "PASSED", "FAILED"
  grade                  Decimal?          @db.Decimal(5, 2)
  historical_document_id Int?
  credited_term          String?           @db.VarChar(50)  // e.g. "1st Year - 1st Sem"
  remarks                String?           @db.Text
  created_at             DateTime          @default(now())
  updated_at             DateTime          @updatedAt

  prospectus             ScholarProspectus @relation(fields: [prospectus_id], references: [prospectus_id], onDelete: Cascade)
  historical_document    ScholarDocument?  @relation(fields: [historical_document_id], references: [document_id], onDelete: SetNull)

  @@index([prospectus_id])
  @@index([subject_code])
  @@map("prospectus_subjects")
}